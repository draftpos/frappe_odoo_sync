<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_havanoposdesk_product_form_inherit_variants" model="ir.ui.view">
        <field name="name">havanoposdesk.product.form.inherit.variants</field>
        <field name="model">havanoposdesk.product</field>
        <field name="inherit_id" ref="havanoposdesk_odoo.view_havanoposdesk_product_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@string='Product information']" position="inside">
                <field name="has_variants" class="border-bottom border-dark"/>
                <field name="is_variant" class="border-bottom border-dark"/>
                <field name="template_id" invisible="is_variant == False" class="border-bottom border-dark" options="{'no_create': True, 'no_create_edit': True}"/>
            </xpath>
            
            <xpath expr="//page[@string='Details']" position="after">
                <page string="Variance" name="variance" invisible="has_variants == False">
                    <field name="variant_ids">
                        <list>
                            <field name="name"/>
                            <field name="item_code"/>
                            <field name="selling_price"/>
                            <field name="buying_price"/>
                            <field name="on_hand_qty"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
