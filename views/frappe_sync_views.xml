<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_tenant_frappe_settings_form" model="ir.ui.view">
        <field name="name">tenant.frappe.settings.form</field>
        <field name="model">havanoposdesk.tenant</field>
        <field name="inherit_id" ref="havanoposdesk_odoo.view_havanoposdesk_tenant_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='restaurant_mode_enabled']" position="after">
                <field name="sync_to_frappe" widget="boolean_toggle"/>
            </xpath>
            <notebook position="inside">
                <page string="Frappe / ERPNext" name="frappe_erpnext_sync" invisible="sync_to_frappe == False">
                    <group>
                        <field name="frappe_url" required="sync_to_frappe == True"/>
                        <field name="frappe_api_key" required="sync_to_frappe == True"/>
                        <field name="frappe_api_secret" required="sync_to_frappe == True" password="True"/>
                    </group>
                    <button string="Test Connection" type="object" name="action_test_frappe_connection" class="oe_highlight btn-info" icon="fa-plug"/>
                    <button string="Sync Now" type="object" name="action_sync_now" class="oe_highlight btn-success" icon="fa-refresh"/>
                    
                    <field name="frappe_sync_log_ids" readonly="1" class="mt-4">
                        <list string="Sync Logs" default_order="create_date desc" decoration-success="status == 'success'" decoration-danger="status == 'error'" decoration-info="status == 'skipped'">
                            <field name="create_date" string="Created on"/>
                            <field name="entity"/>
                            <field name="status" widget="badge"
                                decoration-success="status == 'success'"
                                decoration-danger="status == 'error'"
                                decoration-info="status == 'skipped'"/>
                            <field name="records_synced" string="Records ..."/>
                            <field name="details" optional="hide"/>
                        </list>
                    </field>
                </page>
            </notebook>
        </field>
    </record>

    <record id="action_frappe_sync_log" model="ir.actions.act_window">
        <field name="name">Frappe Sync Logs</field>
        <field name="res_model">frappe.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_frappe_sync_log_tree" model="ir.ui.view">
        <field name="name">frappe.sync.log.tree</field>
        <field name="model">frappe.sync.log</field>
        <field name="arch" type="xml">
            <list create="false" edit="false" default_order="create_date desc"
                  decoration-success="status == 'success'"
                  decoration-danger="status == 'error'"
                  decoration-info="status == 'skipped'">
                <field name="create_date" string="Created on"/>
                <field name="tenant_id"/>
                <field name="entity"/>
                <field name="status" widget="badge"
                    decoration-success="status == 'success'"
                    decoration-danger="status == 'error'"
                    decoration-info="status == 'skipped'"/>
                <field name="records_synced" string="Records"/>
                <field name="details" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_frappe_sync_log_form" model="ir.ui.view">
        <field name="name">frappe.sync.log.form</field>
        <field name="model">frappe.sync.log</field>
        <field name="arch" type="xml">
            <form create="false" edit="false">
                <sheet>
                    <group>
                        <group>
                            <field name="tenant_id"/>
                            <field name="create_date"/>
                            <field name="entity"/>
                        </group>
                        <group>
                            <field name="status" widget="badge" decoration-success="status == 'success'" decoration-danger="status == 'error'"/>
                            <field name="records_synced"/>
                        </group>
                    </group>
                    <group string="Details">
                        <field name="details" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <menuitem id="menu_frappe_sync_log" name="Sync Logs" parent="havanoposdesk_odoo.menu_saas_root" action="action_frappe_sync_log" sequence="90"/>
</odoo>
